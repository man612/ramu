{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://man612.github.io/ramu/schemas/pack-index.schema.json",
  "title": "Ramu pack catalog",
  "type": "object",
  "required": ["version", "default_pack_id", "packs"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "default_pack_id": {"type": "string", "minLength": 3},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "institution", "program", "academic_year", "period_id", "period_label", "status", "maintainer", "manifest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "name": {"type": "string", "minLength": 3},
          "institution": {"type": "string", "minLength": 2},
          "program": {"type": "string", "minLength": 2},
          "academic_year": {"type": "string", "minLength": 4},
          "period_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "period_label": {"type": "string", "minLength": 2},
          "status": {"type": "string", "enum": ["source-verified", "verified", "community", "experimental", "deprecated"]},
          "maintainer": {"type": "string", "enum": ["ramu", "community"]},
          "manifest": {"type": "string", "pattern": "^[^/].*manifest\\.json$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
