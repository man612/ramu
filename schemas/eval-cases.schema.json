{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://man612.github.io/ramu/schemas/eval-cases.schema.json",
  "title": "Ramu eval contract suite",
  "type": "object",
  "required": ["version", "suite_id", "scope", "cases"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "scope": {"type": "string", "enum": ["core", "institution", "program", "pack"]},
    "scope_ref": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "intent", "scenario", "expected_behaviors", "forbidden_behaviors", "contracts"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]{2}$"},
          "title": {"type": "string"},
          "intent": {"type": "string"},
          "applies_to": {"type": "array", "items": {"type": "string"}},
          "scenario": {"type": "string"},
          "expected_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "contains"],
              "properties": {
                "file": {"type": "string"},
                "contains": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "core"}}, "required": ["scope"]},
      "then": {"not": {"required": ["scope_ref"]}},
      "else": {"required": ["scope_ref"]}
    }
  ],
  "additionalProperties": false
}
