{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://man612.github.io/ramu/schemas/pack-manifest.schema.json",
  "title": "Ramu pack manifest",
  "type": "object",
  "required": [
    "schema_version", "id", "name", "institution", "program", "academic_year", "period_id", "period_label",
    "total_sks", "status", "maintainer", "pack_version", "contract_version", "project_instructions",
    "learning_protocols", "courses", "sources", "source_registries", "eval_suites", "source_verified_at"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "name": {"type": "string", "minLength": 3},
    "institution": {"type": "string", "minLength": 2},
    "program": {"type": "string", "minLength": 2},
    "academic_year": {"type": "string", "minLength": 4},
    "period_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "period_label": {"type": "string", "minLength": 2},
    "total_sks": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["source-verified", "verified", "community", "experimental", "deprecated"]},
    "maintainer": {"type": "string", "enum": ["ramu", "community"]},
    "pack_version": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "project_instructions": {"type": "string", "minLength": 3},
    "learning_protocols": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "short_name", "project_name", "sks", "focus", "file"],
        "properties": {
          "code": {"type": "string", "minLength": 2},
          "name": {"type": "string", "minLength": 2},
          "short_name": {"type": "string", "minLength": 1},
          "project_name": {"type": "string", "minLength": 2},
          "sks": {"type": "integer", "minimum": 0},
          "focus": {"type": "string", "minLength": 3},
          "exam_slot": {"type": "string"},
          "material": {"type": "string"},
          "practice": {"type": "string"},
          "service": {"type": "string"},
          "file": {"type": "string", "minLength": 3}
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name", "url", "registry_id"],
        "properties": {
          "type": {"type": "string"},
          "name": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "registry_id": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "source_registries": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "eval_suites": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evalSuite"}
    },
    "source_verified_at": {"type": "string", "format": "date"}
  },
  "$defs": {
    "evalSuite": {
      "type": "object",
      "required": ["id", "scope", "contracts", "behavior"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "scope": {"type": "string", "enum": ["core", "institution", "program", "pack"]},
        "scope_ref": {"type": "string", "minLength": 1},
        "contracts": {"type": "string", "minLength": 3},
        "behavior": {"type": "string", "minLength": 3}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "core"}}, "required": ["scope"]},
          "then": {"not": {"required": ["scope_ref"]}},
          "else": {"required": ["scope_ref"]}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
