{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://man612.github.io/ramu/schemas/source-registry.schema.json",
  "title": "Ramu source registry",
  "type": "object",
  "required": ["version", "scope", "verified_at", "sources"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "scope": {"type": "string", "enum": ["global", "institution", "program", "pack"]},
    "institution_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "institution": {"type": "string"},
    "program_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "program": {"type": "string"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "verified_at": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "authority", "url", "canonical_for", "freshness_class", "verified_at", "review_interval_days", "watch", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 3},
          "kind": {"type": "string"},
          "authority": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "canonical_for": {"type": "array", "items": {"type": "string"}},
          "freshness_class": {"type": "string"},
          "verified_at": {"type": "string", "format": "date"},
          "review_interval_days": {"type": "integer", "minimum": 1},
          "watch": {"type": "boolean"},
          "status": {"type": "string", "enum": ["active", "secondary", "signal-only"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "global"}}, "required": ["scope"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["institution_id"]},
            {"required": ["program_id"]},
            {"required": ["pack_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "institution"}}, "required": ["scope"]},
      "then": {
        "required": ["institution_id", "institution"],
        "not": {"anyOf": [{"required": ["program_id"]}, {"required": ["pack_id"]}]}
      }
    },
    {
      "if": {"properties": {"scope": {"const": "program"}}, "required": ["scope"]},
      "then": {
        "required": ["institution_id", "institution", "program_id", "program"],
        "not": {"required": ["pack_id"]}
      }
    },
    {
      "if": {"properties": {"scope": {"const": "pack"}}, "required": ["scope"]},
      "then": {"required": ["institution_id", "institution", "program_id", "program", "pack_id"]}
    }
  ],
  "additionalProperties": false
}
