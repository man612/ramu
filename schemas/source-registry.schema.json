{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://man612.github.io/ramu/schemas/source-registry.schema.json",
  "title": "Ramu source registry",
  "type": "object",
  "required": ["version", "scope", "verified_at", "sources"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "scope": {"type": "string", "enum": ["global", "institution", "program", "pack"]},
    "institution_id": {"$ref": "#/$defs/machineId"},
    "institution": {"type": "string", "minLength": 2},
    "program_id": {"$ref": "#/$defs/machineId"},
    "program": {"type": "string", "minLength": 2},
    "pack_id": {"$ref": "#/$defs/machineId"},
    "verified_at": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "authority", "url", "canonical_for", "freshness_class", "verified_at", "review_interval_days", "watch", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 3},
          "kind": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "canonical_for": {"type": "array", "items": {"type": "string"}},
          "freshness_class": {"type": "string", "minLength": 1},
          "verified_at": {"type": "string", "format": "date"},
          "review_interval_days": {"type": "integer", "minimum": 1},
          "watch": {"type": "boolean"},
          "status": {"type": "string", "enum": ["active", "secondary", "signal-only"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "status", "summary", "evidence", "reviewed_at", "review_interval_days"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "topic": {"type": "string", "minLength": 3},
          "status": {"type": "string", "enum": ["confirmed", "conflicted", "needs-review", "deprecated"]},
          "summary": {"type": "string", "minLength": 8},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_id", "locator", "observation"],
              "properties": {
                "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
                "locator": {"type": "string", "minLength": 1},
                "observation": {"type": "string", "minLength": 3}
              },
              "additionalProperties": false
            }
          },
          "reviewed_at": {"type": "string", "format": "date"},
          "review_interval_days": {"type": "integer", "minimum": 1},
          "operational_policy": {"type": "string", "minLength": 8},
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "conflicted"}}, "required": ["status"]},
            "then": {"required": ["operational_policy"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "global"}}, "required": ["scope"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["institution_id"]},
            {"required": ["program_id"]},
            {"required": ["pack_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "institution"}}, "required": ["scope"]},
      "then": {"required": ["institution_id", "institution"]}
    },
    {
      "if": {"properties": {"scope": {"const": "program"}}, "required": ["scope"]},
      "then": {"required": ["institution_id", "institution", "program_id", "program"]}
    },
    {
      "if": {"properties": {"scope": {"const": "pack"}}, "required": ["scope"]},
      "then": {"required": ["institution_id", "institution", "program_id", "program", "pack_id"]}
    }
  ],
  "$defs": {
    "machineId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    }
  },
  "additionalProperties": false
}
